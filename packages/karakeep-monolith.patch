+fn collect_fragment_targets(node: &Handle, targets: &mut HashSet<String>) {
+    if let NodeData::Element { ref name, .. } = node.data {
+        if let Some(id) = get_node_attr(node, "id") {
+            if !id.is_empty() {
+                targets.insert(id);
+            }
+        }
+
+        // HTML also supports the legacy <a name="..."> fragment target.
+        if name.local.as_ref() == "a" {
+            if let Some(anchor_name) = get_node_attr(node, "name") {
+                if !anchor_name.is_empty() {
+                    targets.insert(anchor_name);
+                }
+            }
+        }
+    }
+
+    for child in node.children.borrow().iter() {
+        collect_fragment_targets(child, targets);
+    }
+}
+
+fn rewrite_fragment_navigation_nodes(
+    node: &Handle,
+    archive_url: &str,
+    targets: &HashSet<String>,
+    missing_targets: &mut HashSet<String>,
+) {
+    if let NodeData::Element { ref name, .. } = node.data {
+        if name.local.as_ref() == "a" || name.local.as_ref() == "area" {
+            if let Some(href) = get_node_attr(node, "href") {
+                let trimmed_href = href.trim();
+
+                // Keep an empty hash (commonly used as a UI placeholder) and
+                // every non-fragment URL on monolith's existing code path.
+                if trimmed_href.len() > 1 && trimmed_href.starts_with('#') {
+                    let fragment = percent_decode_str(&trimmed_href[1..])
+                        .decode_utf8_lossy()
+                        .to_string();
+                    if !targets.contains(&fragment) {
+                        missing_targets.insert(fragment);
+                    }
+
+                    set_node_attr(
+                        node,
+                        "href",
+                        Some(format!("{}{}", archive_url, trimmed_href)),
+                    );
+                }
+            }
+        }
+    }
+
+    for child in node.children.borrow().iter() {
+        rewrite_fragment_navigation_nodes(child, archive_url, targets, missing_targets);
+    }
+}
+
+pub fn rewrite_fragment_navigation(document: &Handle, archive_url: &str) -> Vec<String> {
+    let mut targets = HashSet::new();
+    collect_fragment_targets(document, &mut targets);
+
+    let mut missing_targets = HashSet::new();
+    rewrite_fragment_navigation_nodes(document, archive_url, &targets, &mut missing_targets);
+
+    let mut result: Vec<String> = missing_targets.into_iter().collect();
+    result.sort();
+    result
+}
