set -e

if [ ! -f main.go ]; then
  echo "main.go was not found; run act from a task directory." >&2
  exit 2
fi

if [ ! -d tests ]; then
  echo "tests directory was not found; create the task with acn first." >&2
  exit 2
fi

build_dir="$(mktemp --directory --tmpdir atcoder-act.XXXXXX)"
trap 'rm -rf "$build_dir"' EXIT

# The project library package is merged into the entry file for local testing
# and submission.
atcoder-snippet --entry main.go --output "$build_dir/main.go"
go build -o "$build_dir/main" "$build_dir/main.go"
oj test -c "$build_dir/main" -d tests --ignore-spaces-and-newlines "$@"
